{
  "name": "youneek-xyz",
  "compatibility_date": "2026-08-27",
  // workers.dev + preview_urls power per-PR aliases like
  // <alias>-youneek-xyz.<account>.workers.dev without touching youneek.xyz
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "youneek.xyz", "custom_domain": true },
    { "pattern": "www.youneek.xyz", "custom_domain": true }
  ]
}
